# DQA-Trace Backend Environment Configuration
PORT=5000
NODE_ENV=production

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Industry 4.0 IoT Edge Device Authentication Secret Key
EDGE_API_KEY=dqa-edge-secret-2026

# Supabase PostgreSQL Configuration
# If omitted, backend will operate in local in-memory fallback store mode
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
